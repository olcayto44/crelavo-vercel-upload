FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates tini curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY worker-deps/package.json worker-deps/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm audit --omit=dev --audit-level=high
COPY scripts/studio-ffmpeg-compose.mjs scripts/studio-mp4-worker.mjs scripts/studio-mp4-runtime-test.mjs ./scripts/
RUN ffmpeg -version && ffprobe -version && ffmpeg -hide_banner -filters 2>&1 | grep arnndn
RUN mkdir -p /opt/rnnoise && curl --fail --silent --show-error --location https://raw.githubusercontent.com/richardpl/arnndn-models/0fda24c46d78f0207d820bb970fbe85c1971b39c/std.rnnn -o /opt/rnnoise/std.rnnn && node -e 'const fs=require("fs"),c=require("crypto"),b=fs.readFileSync("/opt/rnnoise/std.rnnn");if(c.createHash("sha1").update("blob "+b.length+"\\0".replace("\\0",String.fromCharCode(0))).update(b).digest("hex")!=="2c940d14b54486e50cdd188232a3f1cb75ec6af7")process.exit(1)'
ENV STUDIO_RNNOISE_MODEL=/opt/rnnoise/std.rnnn
RUN node scripts/studio-mp4-runtime-test.mjs
USER node
ENTRYPOINT ["/usr/bin/tini","-s","--"]
CMD ["node","scripts/studio-mp4-runtime-test.mjs"]
