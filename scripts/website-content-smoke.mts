import { stripTypeScriptTypes } from "node:module";
import { readFileSync } from "node:fs";
import { generateDeterministicWebsiteSource } from "../src/lib/providers/website-template.ts";
import { sanitizeWebsiteContent, websiteContentFromSource, validateWebsiteSettings, websitePublishingGuide, websiteVersionHistory } from "../src/lib/website-content.ts";
import { buildDeliveryEntries, buildPreviewHtml } from "../src/lib/automatic-delivery-builder.ts";
function assert(value: unknown, message: string): asserts value { if (!value) throw new Error(message); }
// Pure local generation: never spend on a provider during smoke tests.
delete process.env.OPENAI_API_KEY;
const generated = await generateDeterministicWebsiteSource({ brief: "A reliable scheduling product for small teams", brand: "Local Test", audience: "small teams", siteType: "saas", style: "clear", scope: "marketing_website", pages: ["Home"], features: ["Calendar", "Scheduling", "Teams"] });
const original = { websiteFiles: generated.files };
const initial = websiteContentFromSource(original);
assert(initial.heroTitle === 'Local Test makes the next step feel simple.', 'editor defaults must match actual generated hero');
assert((initial.faq as unknown[]).length === 3, 'source FAQ extraction failed');
assert((initial.featureBodies as string[]).length === 3 && String(initial.aboutBody).startsWith('Every surface'), 'default source copy extraction failed');
const content = sanitizeWebsiteContent({ ...initial, faq: [{ question: 'Only <question>', answer: 'Only & answer' }], features: ['New feature'], featureBodies: ['New feature body'], pricingTitles: ['Custom plan'], pricingBodies: ['Verified plan copy'], workflowTitles: ['New step'], workflowBodies: ['New step body'], navLabels: ['New menu'], footerText: 'New footer', seoDescription: 'SEO <description>', logoUrl: 'https://example.com/logo.png', heroImageUrl: 'https://example.com/hero.jpg', contactEndpoint: 'https://formspree.io/f/test123', publishDomain: 'www.example.com', maliciousField: 'ignored' });
assert(!('maliciousField' in content), 'unknown fields must not persist');
assert(!validateWebsiteSettings(content), 'valid settings rejected');
for (const invalid of [{ logoUrl: 'javascript:alert(1)' }, { heroImageUrl: 'https://127.0.0.1/private' }, { contactEndpoint: 'https://evil.example/collect' }, { contactEndpoint: 'https://formspree.io.evil.example/f/test' }, { publishDomain: 'https://example.com/' }, { contactEmail: 'invalid' }]) assert(validateWebsiteSettings(invalid), 'unsafe setting accepted');
const production = { id: 'website-test', production_type: 'website', package_id: 'website_builder', output_json: { ...original, websiteContent: content } };
const preview = buildPreviewHtml(production);
for (const expected of ['Only &lt;question&gt;', 'Only &amp; answer', 'New feature body', 'Custom plan', 'Verified plan copy', 'New step body', 'New menu', 'New footer', 'SEO &lt;description&gt;', 'https://example.com/logo.png', 'https://example.com/hero.jpg', 'data-connected-form="true"', 'event.currentTarget.getAttribute']) assert(preview.includes(expected), `managed preview missing ${expected}`);
assert((preview.match(/class="faq-trigger"/g) ?? []).length === 1, 'FAQ removal did not remove original items');
const entries = buildDeliveryEntries(production);
assert(entries.some((e) => e.name === 'PUBLISHING-GUIDE.md' && e.content.includes('www.example.com')), 'publishing guide missing from ZIP');
assert(entries.find((e) => e.name === 'source/index.html')?.content.includes('New feature body'), 'source does not use managed copy');
const emptyFaq = buildPreviewHtml({ ...production, output_json: { ...production.output_json, websiteContent: { ...content, faq: [] } } });
assert(!emptyFaq.includes('class="faq-trigger"'), 'deleting all FAQ entries must be supported');
assert(websitePublishingGuide({}).includes('does not create a hosting project'), 'publishing status must remain honest');
const listing = readFileSync('src/app/api/websites/route.ts', 'utf8');
assert(listing.includes('requireVerifiedRequestUser') && listing.includes('.eq("user_id", userId)') && listing.includes('.eq("production_type", "website")'), 'saved websites must be owner isolated');
const ui = readFileSync('src/components/WebsiteBuilderForm.tsx', 'utf8');
for (const token of ['Bearer ${token}', 'websitePreviewDocument', 'Add question', 'Remove question', 'moveFaq', 'openProject', 'contactEndpoint']) assert(ui.includes(token), `UI missing ${token}`);
const delivery = readFileSync('src/app/api/productions/[id]/delivery/route.ts', 'utf8');
assert(delivery.includes("form-action 'none'") && delivery.includes("connect-src 'none'"), 'preview submission security must remain intact');
assert(websiteVersionHistory({ websiteContentHistory: [{ revision: 1, content: { heroTitle: 'Before' }, source: 'manual' }] })[0].revision === 0, 'legacy history must use true version numbers');
assert(websiteVersionHistory({ websiteContentHistoryVersion: 2, websiteContentHistory: [{ revision: 1, content: { heroTitle: 'After' }, source: 'manual' }] })[0].revision === 1, 'new history must retain true version numbers');
// Exercise the actual route handlers with an in-memory database; no live customer record is changed.
const routeSource = readFileSync('src/app/api/website-content/[id]/route.ts', 'utf8').replace(/^import .*;\r?\n/gm, '').replace(/export async function /g, 'async function ');
let row: Record<string, any> = { id: 'website-test', user_id: 'owner', production_type: 'website', updated_at: 'initial', output_json: { ...original, websiteContent: initial, websiteContentRevision: 0 } };
let conflict = false;
const database = () => ({ from: () => {
  const filters: Array<[string, unknown]> = []; let patch: Record<string, unknown> | null = null;
  const query: any = { select: () => query, eq: (key: string, value: unknown) => { filters.push([key, value]); return query; }, is: (key: string, value: unknown) => { filters.push([key, value]); return query; }, update: (value: Record<string, unknown>) => { patch = value; return query; }, maybeSingle: async () => { const matches = filters.every(([key, value]) => row[key] === value); if (!matches || (patch && conflict)) return { data: null, error: null }; if (patch) row = { ...row, ...patch }; return { data: structuredClone(row), error: null }; } };
  return query;
} });
const routeFactory = new Function('requireVerifiedRequestUser', 'supabaseAdmin', 'rejectSuspiciousText', 'clientIpFromRequest', 'rateLimit', 'rateLimitResponse', 'sanitizeWebsiteContent', 'validateWebsiteSettings', 'websiteContentFromSource', 'websiteVersionHistory', stripTypeScriptTypes(routeSource) + '; return { GET, PUT, POST };');
const handlers = routeFactory(async (_request: Request, userId: string) => userId === 'owner' || userId === 'stranger' ? { ok: true } : { ok: false, response: Response.json({ error: 'unauthorized' }, { status: 401 }) }, database, () => ({ ok: true }), () => 'local-test', () => ({ allowed: true }), () => Response.json({}, { status: 429 }), sanitizeWebsiteContent, validateWebsiteSettings, websiteContentFromSource, websiteVersionHistory);
const params = { params: Promise.resolve({ id: 'website-test' }) };
const request = (body: unknown) => new Request('https://local.test/api/website-content/website-test', { method: 'POST', body: JSON.stringify(body), headers: { 'Content-Type': 'application/json' } });
assert((await handlers.GET(new Request('https://local.test?user_id=stranger'), params)).status === 403, 'another user must not open website');
const saved = await handlers.PUT(request({ user_id: 'owner', content: { contactTitle: 'Saved contact', faq: [{ question: 'Saved Q', answer: 'Saved A' }] } }), params);
assert(saved.status === 200, 'authenticated partial update failed');
assert(row.output_json.websiteContent.heroTitle === initial.heroTitle, 'partial update erased unrelated fields');
const reopened = await (await handlers.GET(new Request('https://local.test?user_id=owner'), params)).json();
assert(reopened.content.contactTitle === 'Saved contact' && reopened.history[0].revision === 0, 'reopen did not load saved copy/history');
const restored = await handlers.POST(request({ user_id: 'owner', action: 'rollback', revision: 0 }), params);
assert(restored.status === 200 && row.output_json.websiteContent.heroTitle === initial.heroTitle, 'rollback failed');
conflict = true;
assert((await handlers.PUT(request({ user_id: 'owner', content: { heroTitle: 'Must not overwrite' } }), params)).status === 409, 'concurrent save must not silently overwrite');
conflict = false;
assert((await handlers.PUT(request({ user_id: 'owner', content: { contactEndpoint: 'https://evil.example' } }), params)).status === 400, 'invalid provider endpoint must not persist');
console.log('website-content-smoke ok');
