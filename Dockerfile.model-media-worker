FROM node:24-trixie-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY scripts/model-media-worker.cjs scripts/model-media-worker-smoke.cjs ./scripts/
USER node
RUN node scripts/model-media-worker-smoke.cjs && MODEL_MEDIA_WORKER_ENABLED=false node scripts/model-media-worker.cjs
CMD ["node","scripts/model-media-worker.cjs"]
